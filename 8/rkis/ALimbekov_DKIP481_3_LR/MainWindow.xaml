<Window x:Class="ALimbekov_DKIP481_3_LR.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ALimbekov_DKIP481_3_LR"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid x:Name="GridRoot" Background="GreenYellow">
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4" FontSize="30" x:Name="TextLabel"/>
        <Button Grid.Row="1" Grid.Column="0" FontSize="30" x:Name="_1">1</Button>
        <Button Grid.Row="1" Grid.Column="1" FontSize="30" x:Name="_2">2</Button>
        <Button Grid.Row="1" Grid.Column="2" FontSize="30" x:Name="_3">3</Button>
        <Button Grid.Row="2" Grid.Column="0" FontSize="30" x:Name="_4">4</Button>
        <Button Grid.Row="2" Grid.Column="1" FontSize="30" x:Name="_5">5</Button>
        <Button Grid.Row="2" Grid.Column="2" FontSize="30" x:Name="_6">6</Button>
        <Button Grid.Row="3" Grid.Column="0" FontSize="30" x:Name="_7">7</Button>
        <Button Grid.Row="3" Grid.Column="1" FontSize="30" x:Name="_8">8</Button>
        <Button Grid.Row="3" Grid.Column="2" FontSize="30" x:Name="_9">9</Button>
        <Button Grid.Row="4" Grid.Column="1" FontSize="30" x:Name="_0">0</Button>

        <Button Grid.Row="1" Grid.Column="3" FontSize="30" x:Name="plus">+</Button>
        <Button Grid.Row="2" Grid.Column="3" FontSize="30" x:Name="minus">-</Button>
        <Button Grid.Row="3" Grid.Column="3" FontSize="30" x:Name="product">*</Button>
        <Button Grid.Row="4" Grid.Column="3" FontSize="30" x:Name="devide">/</Button>
        <Button Grid.Row="1" Grid.Column="4" FontSize="30" x:Name="d">1/x</Button>
        <Button Grid.Row="4" Grid.Column="3" FontSize="30" x:Name="df">/</Button>
        
        <Button Grid.Row="4" Grid.Column="2" FontSize="30">-/+</Button>
        <Button Grid.Row="4" Grid.Column="0" FontSize="30">.</Button>
        
        <Button Grid.Row="0" Grid.Column="4" FontSize="30" x:Name="ac">AC</Button>
        <Button Grid.Row="4" Grid.Column="4" FontSize="30">=</Button>
    </Grid>
</Window>
